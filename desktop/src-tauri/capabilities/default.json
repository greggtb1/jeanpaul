{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.blowmyjob.agent",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "blowmyjob-engine",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "blowmyjob-engine",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
