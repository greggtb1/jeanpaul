{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JEAN PAUL Agent",
  "version": "1.0.7",
  "identifier": "com.jeanpaul.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JEAN PAUL Agent",
        "width": 520,
        "height": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/jeanpaul-engine"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["jeanpaul"]
      }
    },
    "shell": {
      "open": true
    }
  }
}
