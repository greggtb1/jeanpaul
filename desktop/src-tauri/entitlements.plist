<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Le sidecar PyInstaller (Python) a besoin d'exécuter du code généré -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Indispensable : charger des libs signées différemment (PyInstaller, Playwright/Chromium) -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Le moteur ouvre des connexions réseau (Supabase, Anthropic, ATS) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
